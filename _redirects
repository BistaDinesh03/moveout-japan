# Internal files must not be served from the public site.
# Cloudflare Pages publishes the repository root, so these paths would
# otherwise expose tests, local tooling, repository notes and README content.
# Redirects run before static assets, so the request never reaches the file.
/tests          /index.html  301
/tests/*        /index.html  301
/scripts        /index.html  301
/scripts/*      /index.html  301
/research       /index.html  301
/research/*     /index.html  301
/README.md      /index.html  301
/.gitignore     /index.html  301

/how-it-works      /pages/how-it-works.html        200
/services          /pages/services.html            200
/pricing           /pages/pricing.html             200
/faq               /pages/faq.html                 200
/blog              /blog/index.html                200